---
/*
  Travel.astro — "Travel" section (#travel).

  Real, honest highlights you told me about (5/7 continents incl. Antarctica,
  all 50 U.S. states) go in as real. Anything I don't actually know (e.g.
  total countries) stays a [PLACEHOLDER] for you to fill.

  Photos aren't wired yet — we use styled placeholder boxes now and swap in
  real images during the Asset Handoff step.
*/
import Section from "./Section.astro";
import StatCard from "./StatCard.astro";

// Placeholder photo slots — replace captions/files during Asset Handoff.
const photos = [
  "[PLACEHOLDER: Antarctica]",
  "[PLACEHOLDER: Spain]",
  "[PLACEHOLDER: Add a third]",
];
---

<Section id="travel" title="Travel" eyebrow="Where I've been">
  <p>
    [PLACEHOLDER: A sentence or two about what travel means to you and a
    standout trip or two. Antarctica and Spain are great anchors.]
  </p>

  <div class="travel__stats">
    <StatCard value="5/7" label="Continents visited" detail="including Antarctica" />
    <StatCard value="50" label="U.S. states" detail="all of them" />
    <StatCard value="[PLACEHOLDER]" label="Countries visited" detail="[optional]" />
  </div>

  <ul class="travel__gallery">
    {
      photos.map((caption) => (
        <li class="photo">
          <div class="photo__placeholder">Image</div>
          <span class="photo__caption">{caption}</span>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .travel__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-3);
    margin: var(--space-4) 0 var(--space-5);
  }

  .travel__gallery {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
  }

  .photo {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* Placeholder box keeps a 4:3 shape so the layout looks right before real
     images exist. aspect-ratio avoids layout shift when photos drop in. */
  .photo__placeholder {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .photo__caption {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
