---
/*
  Nav.astro — site header.

  No JavaScript and no hamburger menu. With five short links there is nothing
  worth hiding behind a toggle, so the bar simply changes shape: on narrow
  screens the brand sits on its own line with the links wrapping underneath,
  and from 640px up it becomes a single sticky row. A disclosure widget here
  would be more code, more failure modes, and worse for the user.

  The header is only sticky on wider screens. On a phone a pinned two-line
  header would eat too much of the viewport, so it scrolls away instead.
*/
import { site, navLinks } from "../data/site";

/* Normalise away any trailing slash so "/about" and "/about/" both match. */
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

function isCurrent(href: string): boolean {
  /* startsWith catches project detail pages, so /projects/foo still marks
     Projects as the current section. */
  return path === href || path.startsWith(href + "/");
}
---

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href="/" aria-current={path === "/" ? "page" : undefined}>
      {site.name}
    </a>

    <nav aria-label="Primary">
      <ul class="nav__links">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .nav__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-3);
  }

  .nav__brand {
    color: var(--text);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .nav__brand:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__links a {
    color: var(--text-dim);
    font-size: var(--fs-sm);
    transition: color 0.15s ease;
  }

  .nav__links a:hover {
    color: var(--text);
    text-decoration: none;
  }

  /* The page you are on, marked for sighted users and screen readers alike. */
  .nav__links a[aria-current="page"] {
    color: var(--text);
  }

  @media (min-width: 640px) {
    .nav {
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .nav__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      height: var(--nav-h);
      padding-block: 0;
    }

    .nav__links {
      gap: var(--space-4);
    }
  }
</style>
