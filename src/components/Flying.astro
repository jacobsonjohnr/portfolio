---
/*
  Flying.astro — "Aviation" section (#flying).

  Honest framing: your private pilot's license is IN PROGRESS — nothing here
  claims a completed license. Numbers I don't actually know (flight hours,
  etc.) stay [PLACEHOLDER] for you to fill in truthfully.
*/
import Section from "./Section.astro";
import StatCard from "./StatCard.astro";
---

<Section id="flying" title="Aviation" eyebrow="Up in the air">
  <p>
    [PLACEHOLDER: A couple sentences on your flying journey — that you're
    working toward your private pilot's license (PPL), what drew you to
    aviation, and what you enjoy about it.]
  </p>

  <div class="flying__layout">
    <div class="flying__stats">
      <StatCard value="PPL" label="License status" detail="in progress" />
      <StatCard value="[PLACEHOLDER]" label="Flight hours" detail="[optional]" />
    </div>

    <figure class="flying__photo">
      <div class="photo__placeholder">Image</div>
      <figcaption class="photo__caption">[PLACEHOLDER: Flying photo]</figcaption>
    </figure>
  </div>
</Section>

<style>
  /* Two-column on wide screens (stats | photo), single column when narrow. */
  .flying__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-4);
    align-items: start;
  }

  .flying__stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .flying__photo {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .photo__placeholder {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .photo__caption {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .flying__layout {
      grid-template-columns: 1fr; /* stack on small screens */
    }
  }
</style>
