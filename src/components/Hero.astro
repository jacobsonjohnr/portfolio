---
/*
  Hero.astro — the homepage's first impression.

  Pure presentation: name, role/tagline, a short intro line, and two
  call-to-action buttons. The copy is placeholder-ish and easy to edit.
  The buttons link to sections that arrive in later phases.
*/
---

<section class="hero">
  <div class="container hero__inner">
    <h1 class="hero__title">
      John Jacobson
    </h1>

    <p class="hero__lead">
      [PLACEHOLDER: one honest line about who you are and what you do — e.g. your
      focus in electrical engineering and the kind of work you want.]
    </p>

    <div class="hero__actions">
      <a href="#projects" class="btn btn--primary">Projects</a>
      <a href="#experience" class="btn btn--ghost">Résumé</a>
      <a href="#contact" class="btn btn--ghost">Contact</a>
    </div>
  </div>
</section>

<style>
  .hero {
    /* Generous vertical space so it feels like a landing moment.
       min-height accounts for the 64px sticky nav above it. */
    display: flex;
    align-items: center;
    min-height: calc(100vh - 64px);
    padding-block: var(--space-6);
  }

  .hero__title {
    margin-bottom: var(--space-3);
  }

  .hero__lead {
    font-size: 1.15rem;
    margin-bottom: var(--space-5);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap; /* buttons stack instead of overflowing on small screens */
    gap: var(--space-3);
  }

  /* Buttons — scoped here for now. If we reuse them elsewhere later,
     we can promote .btn into global.css. */
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.4rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.95rem;
    transition: transform 0.15s ease, background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-2px); /* subtle lift on hover */
  }

  .btn--primary {
    background-color: var(--accent);
    color: #0b1220; /* dark text on the bright accent for contrast */
  }

  .btn--primary:hover {
    background-color: var(--accent-hover);
    color: #0b1220;
  }

  .btn--ghost {
    border: 1px solid var(--border);
    color: var(--text);
  }

  .btn--ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
