---
/*
  About.astro — the "About" section.
  Wraps its content in the reusable <Section>. Copy is placeholder text
  for you to replace with real wording — no invented facts.
*/
import Section from "./Section.astro";
---

<Section id="about" title="About" eyebrow="Who I am">
  <p>
    [PLACEHOLDER: A short, genuine paragraph about who you are — where you
    study, what you focus on in electrical engineering, and what you care
    about. Keep it conversational but professional.]
  </p>
  <p>
    [PLACEHOLDER: A second paragraph if you want — what motivates you, the kind
    of work you want to do, or a line of personality that makes you memorable.]
  </p>
</Section>
