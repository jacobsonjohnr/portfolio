---
/*
  Experience.astro — "Experience" section (#experience).

  R3: a vertical CSS timeline built from src/data/experience.js, plus a
  prominent "Download résumé" button that serves /resume.pdf.

  All timeline text is [PLACEHOLDER] — no invented roles, orgs, or dates.
*/
import Section from "./Section.astro";
import { experience } from "../data/experience.js";
---

<Section id="experience" title="Experience">
  <ol class="timeline">
    {experience.map((entry) => (
      <li class="timeline__item">
        <p class="timeline__dates">{entry.dates}</p>
        <h3 class="timeline__title">{entry.title}</h3>
        <p class="timeline__org">{entry.org}</p>
        <p class="timeline__detail">{entry.detail}</p>
      </li>
    ))}
  </ol>

  <a class="resume-button" href="/resume.pdf" download>Download résumé</a>
</Section>

<style>
  /* Vertical line: a single left border on the list; each item hangs a dot
     on it via ::before. An <ol> (ordered list) because chronology has order. */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--border);
  }

  .timeline__item {
    position: relative;
    padding-left: var(--space-4);
    padding-bottom: var(--space-5);
  }

  .timeline__item:last-child {
    padding-bottom: 0; /* no trailing gap under the final entry */
  }

  /* The dot, centered on the line (translateX(-50%) pulls it half its width
     left so it straddles the 2px border). */
  .timeline__item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background-color: var(--accent);
    transform: translateX(-50%);
  }

  .timeline__dates {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }

  .timeline__title {
    margin-bottom: var(--space-1);
  }

  .timeline__org {
    color: var(--text);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .timeline__detail {
    /* inherits the global muted body color + 65ch cap */
  }

  /* Filled accent button matching Hero's .btn--primary look. Kept local for
     now; if we reuse buttons more, we can promote .btn into global.css later. */
  .resume-button {
    display: inline-flex;
    align-items: center;
    margin-top: var(--space-5);
    padding: 0.7rem 1.4rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.95rem;
    background-color: var(--accent);
    color: #0b1220; /* dark text on bright accent, same as Hero primary */
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .resume-button:hover {
    transform: translateY(-2px);
    background-color: var(--accent-hover);
    color: #0b1220;
  }
</style>
