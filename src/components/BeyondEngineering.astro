---
/*
  BeyondEngineering.astro — "Beyond Engineering" section (#beyond).

  ONE compact section that folds together the personal side: hobbies, travel,
  and flying — all told as PROSE, not scored with stat cards. Flying is framed
  toward what it signals about how Jack works (discipline, systems thinking),
  not "I fly planes."

  Below the prose: a small captioned photo strip (real captions, no metrics).
  Photos aren't wired yet — styled placeholder boxes now, real images during
  Asset Handoff.

  All sentences here are Jack's to write. Claude only provides structure.
*/
import Section from "./Section.astro";

// Placeholder photo slots — replace captions/files during Asset Handoff.
const photos = [
  "[PLACEHOLDER: caption]",
  "[PLACEHOLDER: caption]",
  "[PLACEHOLDER: caption]",
];
---

<Section id="beyond" title="Beyond Engineering">
  <div class="beyond__prose">
    <p>
      [PLACEHOLDER: A short paragraph on who you are outside of engineering —
      the throughline that connects your interests.]
    </p>
    <p>
      [PLACEHOLDER: Flying — written toward what it says about how you think and
      work: preparation, checklists, decision-making under pressure, systems
      thinking. Not a brag about hours or a license.]
    </p>
    <p>
      [PLACEHOLDER: Travel — a sentence or two of real stories (e.g. Antarctica,
      Spain) and what you take from seeing how the world works, told as prose.]
    </p>
  </div>

  <ul class="beyond__strip">
    {
      photos.map((caption) => (
        <li class="beyond__photo">
          <div class="beyond__placeholder">Image</div>
          <span class="beyond__caption">{caption}</span>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .beyond__prose > p + p {
    margin-top: var(--space-3); /* space between paragraphs */
  }

  .beyond__strip {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
  }

  .beyond__photo {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* aspect-ratio reserves the shape now so real photos won't shift the layout */
  .beyond__placeholder {
    aspect-ratio: 3 / 2;
    display: grid;
    place-items: center;
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .beyond__caption {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
