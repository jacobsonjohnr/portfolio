---
/*
  Hobbies.astro — "Beyond Engineering" section (personal interests).

  Flying and travel get their own dedicated sections in Phase 4, so this
  section is for the OTHER personal interests that round you out. Replace
  the placeholder items with real hobbies.
*/
import Section from "./Section.astro";

const hobbies = [
  { title: "[PLACEHOLDER: Hobby]", note: "[PLACEHOLDER: one line about it]" },
  { title: "[PLACEHOLDER: Hobby]", note: "[PLACEHOLDER: one line about it]" },
  { title: "[PLACEHOLDER: Hobby]", note: "[PLACEHOLDER: one line about it]" },
];
---

<Section id="hobbies" title="Beyond Engineering" eyebrow="Outside the lab">
  <p>
    [PLACEHOLDER: A sentence about what you enjoy outside of school and work —
    the things that make you, you. (Flying and travel have their own sections
    below, so save those for there.)]
  </p>

  <ul class="hobbies">
    {
      hobbies.map((item) => (
        <li class="hobbies__card">
          <h3 class="hobbies__title">{item.title}</h3>
          <p class="hobbies__note">{item.note}</p>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .hobbies {
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
  }

  .hobbies__card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-4);
  }

  .hobbies__title {
    font-size: 1.05rem;
    margin-bottom: var(--space-2);
  }

  .hobbies__note {
    margin: 0;
    font-size: 0.95rem;
  }
</style>
