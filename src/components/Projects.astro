---
/*
  Projects.astro — "Projects" section (#projects). The lead/substance section.

  R2: data-driven. Content lives in src/data/projects.js; we map over that
  array to render one card per project. No KPI/stat numbers — plain text + tags.
*/
import Section from "./Section.astro";
import { projects } from "../data/projects.js";
---

<Section id="projects" title="Projects">
  <ul class="projects">
    {projects.map((project) => (
      <li class="project">
        <h3 class="project__title">{project.title}</h3>
        <p class="project__summary">{project.summary}</p>

        <ul class="project__tags">
          {project.tags.map((tag) => <li>{tag}</li>)}
        </ul>

        {project.link && (
          <a
            class="project__link"
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
          >View project →</a>
        )}
      </li>
    ))}
  </ul>
</Section>

<style>
  /* Single-column stack of cards — deliberately NOT a uniform grid, to read
     less like a template and give the substance section room. */
  .projects {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .project {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-4);
  }

  .project__title {
    margin-bottom: var(--space-2);
  }

  /* Tags reuse the same restrained pill language as the About focus list. */
  .project__tags {
    list-style: none;
    padding: 0;
    margin-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project__tags li {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    font-size: 0.85rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .project__link {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: 0.95rem;
  }
</style>
