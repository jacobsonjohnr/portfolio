---
// index.astro — the homepage (route: "/").
// Phase 3: add the About, Engineering, and Hobbies sections below the hero.
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Engineering from "../components/Engineering.astro";
import Hobbies from "../components/Hobbies.astro";
---

<Layout title="John Jacobson — Portfolio">
  <!-- #top is the anchor the nav brand links back to -->
  <span id="top"></span>
  <Nav />
  <main>
    <Hero />
    <About />
    <Engineering />
    <Hobbies />
  </main>
</Layout>
