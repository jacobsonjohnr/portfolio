---
// index.astro — the homepage (route: "/").
// Phase 2: assemble the sticky nav and the hero. Later phases add the
// section components (About, Projects, Travel, ...) below the hero.
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
---

<Layout title="John Jacobson — Portfolio">
  <!-- #top is the anchor the nav brand links back to -->
  <span id="top"></span>
  <Nav />
  <main>
    <Hero />
  </main>
</Layout>
