---
/*
  index.astro — the projects listing at /projects.

  Reads the same collection the detail pages use, so a new Markdown file appears
  here automatically with no edit to this page.
*/
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = await getCollection("projects");
/* Newest first. getTime() gives a number, so the subtraction sorts correctly. */
projects.sort((a, b) => b.data.started.getTime() - a.data.started.getTime());
---

<Layout
  title="Projects"
  description="Embedded hardware, firmware, and digital logic projects by John Jacobson."
>
  <PageHeader
    title="Projects"
    lead="Embedded hardware and digital logic, plus the coursework worth writing up."
  />

  <div class="container listing">
    <ul class="cards">
      {
        projects.map((project) => (
          <li class="cards__item">
            <ProjectCard
              href={`/projects/${project.id}`}
              title={project.data.title}
              summary={project.data.summary}
              status={project.data.status}
              started={project.data.started}
              ended={project.data.ended}
              tech={project.data.tech}
              headingLevel="h2"
            />
          </li>
        ))
      }
    </ul>
  </div>
</Layout>

<style>
  .listing {
    padding-block: var(--space-5) var(--space-6);
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .cards__item {
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border);
  }

  .cards__item:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }
</style>
