---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Figure from "../components/Figure.astro";
---

<Layout
  title="About"
  description="John Jacobson is an electrical engineering student at the University of Illinois working toward embedded systems and firmware."
>
  <PageHeader title="About" />
  <div class="container section">
    <div class="about__portrait">
      <Figure slot="headshot" loading="eager" />
    </div>
    <p>
      I am an engineering student in the Grainger College of Engineering at the
      University of Illinois, working toward electrical engineering.
    </p>
  </div>
</Layout>

<style>
  .section { padding-block: var(--space-5); }

  .about__portrait {
    max-width: 220px;
    margin-bottom: var(--space-4);
  }
</style>
